# 乱序性自测：rob2=div(100/7, 33 拍) 未完成时，年轻 rob3=addi(42) 先写回
# 指令编码逐位核对：
#   lui  x1,0        = 0x000000B7
#   addi x1,x1,100   = 0x06408093  (rs1=x1)
#   addi x2,x0,7     = 0x00700113
#   div  x3,x1,x2    = 0x0220C1B3  (rs2=x2, rs1=x1, rd=x3)
#   addi x4,x0,42    = 0x02A00213
#   addi x10,x0,42   = 0x02A00513
#   lui  x5,0x80000  = 0x800002B7
#   sw   x10,0(x5)   = 0x00A2A023
#   jal  x0,0        = 0x0000006F
# 预期：CDB 写回顺序 rob3(42) 先于 rob2(14)；提交仍按序。退出返回 42
@00000000
b7 00 00 00
93 80 40 06
13 01 70 00
b3 c1 20 02
13 02 a0 02
13 05 a0 02
b7 02 00 80
23 a0 a2 00
6f 00 00 00
